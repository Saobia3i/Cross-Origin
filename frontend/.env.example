# ─────────────────────────────────────────────────────
# DhakaPath Frontend — Environment Variables
# cp .env.example .env  then fill in your values
# ─────────────────────────────────────────────────────

# Backend API base URL (teammate's FastAPI server)
VITE_API_URL=http://localhost:8000

# OpenRouter API key
# Sign up at https://openrouter.ai → Dashboard → API Keys
# Teammate uses this in the backend (FastAPI) — NOT here in frontend
# Keep this in the backend .env only (never expose in frontend build)
# VITE_OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# If you want to call OpenRouter directly from frontend (dev only):
# VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# VITE_OPENROUTER_MODEL=openai/gpt-4o-mini
