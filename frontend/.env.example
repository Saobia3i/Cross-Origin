# Backend API base URL (FastAPI). GET /api/catalog on this host is the endpoint source of truth.
VITE_API_BASE_URL=http://localhost:8000
# Reserved: MSW mock mode. No MSW handlers exist in this repo yet (see ../log.md); keep false.
VITE_USE_MOCKS=false
# Event polling (GET /api/events) interval in ms; 10000-15000 recommended.
VITE_EVENT_POLL_INTERVAL_MS=12000
