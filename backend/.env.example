DATABASE_URL=sqlite:///./data/dhakapath.db
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEMO_SECRET=change_me_debug_secret
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=openrouter
# optional model overrides (free-tier defaults are built in)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# Multimodal model used to extract route details from signboard photos.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_S=8
CHAT_LLM_REWRITE=true
# sessions whose id starts with DEMO may run simulations from chat without logging in (demo script)
CHAT_ALLOW_DEMO_SIMULATION=true
LLM_CACHE_ENABLED=true
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_IMAGES=5
